+  /* I/O declarations may precede the GS execution-mode declarations.
+   * Resolve the stream mask before emitting output variables, otherwise
+   * their Stream decorations are omitted while EmitStreamVertex survives. */
+  auto [declBegin, declEnd] = m_builder.getDeclarations();
